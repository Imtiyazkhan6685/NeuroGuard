<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRootLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_hud"
    android:elevation="14dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Status Pulse Indicator Ring -->
    <View
        android:id="@+id/hudStatusIndicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/accent_green" />

    <!-- Current Count vs Daily Quota -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvReelCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14 / 20 Reels"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Live Reel Dwell Timer & Attention Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDwellTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:07s"
                android:textColor="@color/accent_amber"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAttentionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="• Skimming"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Close button -->
    <ImageView
        android:id="@+id/btnCollapse"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="12dp"
        android:alpha="0.6"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

</LinearLayout>
